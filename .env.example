# Copy this file to `.env` and fill in your keys. `.env` is gitignored.
# `.env.local` (also gitignored) overrides `.env` and is a good place to keep
# real keys if you want a committed `.env` template at some point.

# Required for @claude / @grok / @gpt mentions (OpenRouter unified API).
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional — only needed for the @code mention (Claude Agent SDK).
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=
